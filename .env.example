# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# AI Model Provider (Optional: if not set, Tri-nance uses its built-in deterministic financial NLP intelligence engine)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEFAULT_AI_PROVIDER=deterministic # options: deterministic, openai, gemini, anthropic

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
